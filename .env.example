# Copy to .env and fill in your keys (backend + frontend share this file)

# Frontend (Next.js)
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Backend — LLM
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-nano

# Backend — voice + news
SARVAM_API_KEY=
NEWSDATA_API_KEY=

# Backend — cache + storage
REDIS_URL=redis://localhost:6379
CHROMA_PATH=./data/chroma
HF_EMBEDDING_MODEL=intfloat/multilingual-e5-small
MAX_CONFUSION=3
SESSION_TTL_SECONDS=3600
CA_BUNDLE_TTL_SECONDS=86400
DAILY_CA_ARTICLE_COUNT=10

# Optional — Langfuse tracing
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Sarvam TTS tuning
SARVAM_TTS_SPEAKER=aayan
SARVAM_TTS_PACE=0.93
SARVAM_TTS_TEMPERATURE=0.65
SARVAM_STT_MODE=codemix
