# Copy to .env and fill in your keys (backend + frontend share this file)

# Frontend (Next.js)
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Backend — LLM
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# JSON LLM tasks — non-reasoning models (gpt-5-nano / qwen3 burn tokens on thinking)
CA_BRIEFING_MODEL=gpt-4o-mini
INTERVIEW_JSON_MODEL=gpt-4o-mini

# Backend — voice + news
SARVAM_API_KEY=
NEWSDATA_API_KEY=

# Backend — cache + storage (Upstash on Railway, localhost for dev)
REDIS_URL=redis://localhost:6379
CHROMA_PATH=./data/chroma
HF_EMBEDDING_MODEL=intfloat/multilingual-e5-small
MAX_CONFUSION=3
SESSION_TTL_SECONDS=3600
CA_BUNDLE_TTL_SECONDS=86400
DAILY_CA_ARTICLE_COUNT=10
# Keep true for full Aayan LLM classroom voice. Set false only if OpenAI/Groq quota is hit mid-demo.
CA_USE_LLM_BRIEFING=true
# Listen click: false = fast template for Hindi/English only. Tamil/Bengali/etc. always use LLM.
CA_EXPLAIN_LLM_ON_DEMAND=false
# === CA: news → Upstash Redis on startup if missing/stale (no midnight batch) ===
CA_ALLOW_AUTO_NEWS_FETCH=true
CA_AUTO_VOICE_PREWARM=false
CA_MIDNIGHT_PREWARM_ENABLED=false
CA_STARTUP_CATCHUP_ENABLED=false
CA_BATCH_AI_ONLY_AT_MIDNIGHT=false
# Manual full refresh: GET /current-affairs/daily?refresh=true

# Set false on low-RAM hosts (Railway 512MB) — uses BM25-only RAG, no torch embedding model
RAG_VECTORS_ENABLED=true

# Optional — Langfuse tracing
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Sarvam TTS tuning
SARVAM_TTS_SPEAKER=aayan
SARVAM_TTS_PACE=1.05
# ~60 sec classroom voice (was ~80 sec at 180-220 words + slow pace)
CA_BRIEFING_WORDS_MIN=150
CA_BRIEFING_WORDS_MAX=175
CA_BRIEFING_VOICE_MAX_CHARS=1050
SARVAM_TTS_TEMPERATURE=0.65
SARVAM_STT_MODE=codemix
